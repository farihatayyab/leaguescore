DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leaguescore

# Naya secret banane ke liye:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# SportScore free API (API key ki zaroorat nahi) - https://sportscore.com
# Limit ~10,000 requests / 24h / IP. App khud cache karti hai aur DAILY_LIMIT par ruk jati hai.
SPORTSCORE_TTL=60
SPORTSCORE_DAILY_LIMIT=9000
# Optional: apni site ka naam, SportScore ko pata chal jata hai (?src=)
SPORTSCORE_SRC=my-sports-app

# Fixtures endpoint (guide: /api/v1/fixtures/?sport=&date=&limit=200). "off" likho to purana widget feed (max 50) chalega
SPORTSCORE_FIXTURES=on
# Date ke liye query parameter ka naam (official docs / curl se confirm karo)
SPORTSCORE_DATE_PARAM=date
# Optional: agar ek din mein 200 se zyada fixtures hon to docs ke mutabiq pagination parameter
# SPORTSCORE_PAGE_PARAM=page     # ya offset
# SPORTSCORE_PAGE_MODE=page      # page ya offset

# Site info: Contact page par email dikhane ke liye (optional)
SITE_EMAIL=
# Footer ke social icons: sirf wahi dikhenge jin ka link yahan likha ho (https://...)
SOCIAL_TWITTER=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TELEGRAM=
SOCIAL_YOUTUBE=

# Apni site ka public URL (attribution + password reset email ke link isi se bante hain), e.g. https://leaguescore.com
SITE_URL=http://localhost:3000
# API access: "log" = sab log karo, block mat karo (default) | "enforce" = third-party ke liye valid key + allowed domain zaroori
API_KEY_MODE=log

# TV Guide: EPG data kitne ghante baad khud refresh ho (default 6)
TV_REFRESH_HOURS=6

# ---------- Authentication / Email (Forgot Password) ----------
# Admin ka role database ke users.role column se aata hai (email yahan hardcode nahi hoti).
# Admin banane ke liye:  npm run make-admin -- user@email.com admin
#
# Website ka public URL: reset email ka link isi se banta hai (production mein https://yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SMTP (Gmail): Google Account -> Security -> 2-Step Verification ON -> App passwords se 16-char password banao
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Email ka "From", e.g. LeagueScore <you@gmail.com> (khali ho to SMTP_USER use hota hai)
EMAIL_FROM=
# Reset link kitne minute valid rahe (15 se 30 ke beech, default 30)
RESET_TOKEN_TTL_MINUTES=30
