DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leaguescore

# Naya secret banane ke liye:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# SportScore free API (API key ki zaroorat nahi) - https://sportscore.com
# Limit ~10,000 requests / 24h / IP. App khud cache karti hai aur DAILY_LIMIT par ruk jati hai.
SPORTSCORE_TTL=60
SPORTSCORE_DAILY_LIMIT=9000
# Optional: apni site ka naam, SportScore ko pata chal jata hai (?src=)
SPORTSCORE_SRC=my-sports-app

# matches endpoint mein date ke liye query parameter ka naam (docs mein confirm nahi, curl se test karo)
SPORTSCORE_DATE_PARAM=date
